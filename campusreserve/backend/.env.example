DEBUG=True
SECRET_KEY=change-me-to-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use local sqlite3 automatically (fastest way
# to get started). Set it to use PostgreSQL instead, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/campusreserve_db
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── AI (recommendations + weather report) ───
# Free Gemini key: https://aistudio.google.com/apikey
# Leave empty to use the rule-based fallback (no AI text, everything else works).
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
# OpenAI instead:  AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# Groq instead:    AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile

# ─── Weather (Open-Meteo, no key needed) ───
CAMPUS_LATITUDE=6.2006
CAMPUS_LONGITUDE=-75.5783
